---
layout: base.njk
title: Projects
description: Featured builds — Dung and the Mineflayer companion. Small on purpose.
---
<div class="page-head">
  <p class="kicker">03 · Projects</p>
  <h1>Featured builds.</h1>
  <p class="lede">Kept minimal on purpose: two entries with full notes. Everything else lives in the <a href="{{ '/lab/' | url }}">lab</a> as short notes.</p>
</div>

{% for p in projects %}
<article class="entry" id="{{ p.slug }}">
  <div class="entry-top">
    <span class="entry-index">{{ loop.index | pad2 }}/</span>
    <h2 class="entry-title">{{ p.title }}</h2>
    <span class="stamp {{ p.status }}">{{ p.statusLabel }}</span>
  </div>
  <p class="blurb"><strong>{{ p.oneliner }}</strong></p>
  <p class="blurb">{{ p.body }}</p>
  <p class="entry-meta">
    {% for t in p.tags %}<span class="tag">{{ t }}</span>{% endfor %}
    {% for l in p.links %}<span><a href="{{ l.url }}">{{ l.label }} ↗</a></span>{% endfor %}
    {% if p.note %}<span>{{ p.note }}</span>{% endif %}
  </p>
</article>
{% endfor %}

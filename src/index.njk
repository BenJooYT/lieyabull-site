---
layout: base.njk
title: Shelf
titleHu: Polc
description: "Lieyabull's workshop shelf: featured builds, arcade picks, and the latest notes."
descriptionHu: "Lieyabull műhelypolca: kiemelt építmények, árkád-válogatás és a legfrissebb jegyzetek."
---
{% import "i18n.njk" as i18n %}
<div class="page-head">
  <p class="kicker">{{ i18n.t("01 · Shelf: the den at a glance", "01 · Polc: az odú egy pillantásra") }}</p>
  <h1>{{ i18n.t("Stuff I'm building, kept in one place.", "Amit építek, egy helyen tartva.") }}</h1>
  <p class="lede">{{ i18n.t("Games, Minecraft contraptions, and small experiments. Unfinished counts here, entries say what state they're in.", "Játékok, Minecraft szerkezetek és kisebb kísérletek. A félkész is számít, a bejegyzések megmondják, hol tartanak.") }}</p>
</div>

<div class="shelf">
  <div>
    <h2 class="section-label"><span>{{ i18n.t("Currently building", "Jelenleg épül") }}</span></h2>
    <article class="entry">
      <div class="entry-top">
        <span class="entry-index">a/</span>
        <h3 class="entry-title"><a href="{{ '/projects/' | url }}">Dung</a></h3>
        <span class="stamp active">v1.5.1</span>
      </div>
      <p class="blurb"><span class="lang-en" lang="en">Room-based dungeon roguelite Paper plugin, now at v1.5.1 with branching floors and telegraphed bosses. <a href="{{ '/projects/' | url }}">Project notes →</a></span><span class="lang-hu" lang="hu">Szobákra épülő dungeon rogue-lite Paper plugin, most v1.5.1, elágazó szintekkel és előre jelzett bosokkal. <a href="{{ '/projects/' | url }}">Projektjegyzetek →</a></span></p>
    </article>

    <h2 class="section-label"><span>{{ i18n.t("Featured", "Kiemelt") }}</span><a href="{{ '/projects/' | url }}">{{ i18n.t("all projects →", "összes projekt →") }}</a></h2>
    {% for p in projects %}
    <article class="entry">
      <div class="entry-top">
        <span class="entry-index">{{ loop.index }}/</span>
        <h3 class="entry-title"><a href="{{ '/projects/' | url }}">{{ p.title }}</a></h3>
        <span class="stamp {{ p.status }}"><span class="lang-en" lang="en">{{ p.statusLabel }}</span><span class="lang-hu" lang="hu">{{ p.statusLabelHu or p.statusLabel }}</span></span>
      </div>
      <p class="blurb">{{ i18n.t(p.oneliner, p.onelinerHu) }}</p>
    </article>
    {% endfor %}

    <h2 class="section-label"><span>{{ i18n.t("Arcade picks", "Árkád-válogatás") }}</span><a href="{{ '/games/' | url }}">{{ i18n.t("full arcade →", "teljes árkád →") }}</a></h2>
    {% for g in games | slice(0, 3) %}
    <article class="entry">
      <div class="entry-top">
        <span class="entry-index">g{{ loop.index }}/</span>
        <h3 class="entry-title"><a href="{{ '/games/' | url }}">{{ g.title }}</a></h3>
        <span class="stamp {{ g.status }}"><span class="lang-en" lang="en">{{ g.status }}</span><span class="lang-hu" lang="hu">{{ i18n.statusHu(g.status) }}</span></span>
        {% if g.version %}<span class="tag">v{{ g.version }}</span>{% endif %}
      </div>
      <p class="blurb">{{ i18n.t(g.blurb, g.blurbHu) }}</p>
      <p class="entry-meta"><span>{{ i18n.t(g.players, g.playersHu) }}</span><span>{{ i18n.t("via arcade ↗", "az árkád oldalán ↗") }}</span></p>
    </article>
    {% endfor %}

    <h2 class="section-label"><span>{{ i18n.t("Fresh from the lab", "Frissen a laborból") }}</span><a href="{{ '/lab/' | url }}">{{ i18n.t("all notes →", "összes jegyzet →") }}</a></h2>
    {% for e in lab | slice(0, 3) %}
    <article class="entry">
      <div class="entry-top">
        <span class="entry-index">l{{ loop.index }}/</span>
        <h3 class="entry-title"><a href="{{ '/lab/' | url }}">{{ e.title }}</a></h3>
        <span class="stamp {{ e.status }}"><span class="lang-en" lang="en">{{ e.status }}</span><span class="lang-hu" lang="hu">{{ i18n.statusHu(e.status) }}</span></span>
      </div>
      <p class="blurb">{{ i18n.t(e.text, e.textHu) }}</p>
    </article>
    {% endfor %}
  </div>

  <aside class="margin-note" aria-label="Now snapshot">
    <h2>{{ i18n.t("Now", "Most") }} · <a href="{{ '/now/' | url }}">{{ i18n.t("full page", "teljes oldal") }}</a></h2>
    <dl>
      <div><dt>{{ i18n.t("Building", "Építés") }}</dt><dd>{{ i18n.t(now.building, now.buildingHu) }}</dd></div>
      <div><dt>{{ i18n.t("Playing", "Játék") }}</dt><dd>{{ i18n.t(now.playing, now.playingHu) }}</dd></div>
      <div><dt>{{ i18n.t("Learning", "Tanulás") }}</dt><dd>{{ i18n.t(now.learning, now.learningHu) }}</dd></div>
      <div><dt>{{ i18n.t("Last experiment", "Utolsó kísérlet") }}</dt><dd>{{ i18n.t(now.lastexperiment, now.lastexperimentHu) }}</dd></div>
    </dl>
  </aside>
</div>
